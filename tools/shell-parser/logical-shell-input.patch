+package syntax
+
+import "sort"
+
+// continuationMap is lexical provenance, recorded by the existing input reader
+// only for discarded continuations. It is owned by one parse and retained by
+// that tree's positions; no executable bytes are rewritten or rescanned.
+type continuationMap struct{ gaps []continuationGap }
+type continuationGap struct{ start, end Pos }
+
+func (m *continuationMap) add(p Pos, n int) Pos {
+	result := p
+	result.continuations = nil
+	result = posAddCol(result, n)
+	target := int64(result.offs)
+	if n > 0 {
+		first := sort.Search(len(m.gaps), func(i int) bool { return m.gaps[i].start.offs >= p.offs })
+		for i := first; i < len(m.gaps) && int64(m.gaps[i].start.offs) < target; i++ {
+			gap := m.gaps[i]
+			target += int64(gap.end.offs - gap.start.offs)
+			result = posAddCol(gap.end, int(target-int64(gap.end.offs)))
+		}
+	} else if n < 0 {
+		first := sort.Search(len(m.gaps), func(i int) bool { return m.gaps[i].end.offs > p.offs }) - 1
+		for i := first; i >= 0 && int64(m.gaps[i].end.offs) > target; i-- {
+			gap := m.gaps[i]
+			target -= int64(gap.end.offs - gap.start.offs)
+			result = posAddCol(gap.start, int(target-int64(gap.start.offs)))
+		}
+	}
+	result.continuations = m
+	return result
+}
