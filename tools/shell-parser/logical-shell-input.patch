+// logicalRune and logicalPeek own escaped-newline removal before active
+// token classification. Quoted data and comment readers keep physical rune().
+func (p *Parser) logicalRune() rune {
+	p.rune()
+	return p.logicalCurrent()
+}
+
+func (p *Parser) logicalCurrent() rune {
+	r := p.r
+	for r == escNewl {
+		r = p.rune()
+	}
+	return r
+}
+
+// physicalAhead preserves current rune/position while filling a lookahead
+// window. The host admits the entire source before parsing; growth is bounded
+// by those source bytes and is not an independent command cache.
+func (p *Parser) physicalAhead(offset int) byte {
+	for int(p.bsp)+offset >= len(p.bs) {
+		if p.readEOF {
+			return utf8.RuneSelf
+		}
+		if len(p.bs)-int(p.bsp) == len(p.readBuf) {
+			grown := make([]byte, len(p.readBuf)*2)
+			copy(grown, p.readBuf)
+			p.readBuf, p.bs = grown, grown[:len(p.bs)]
+		}
+		if p.fill() == 0 {
+			return utf8.RuneSelf
+		}
+	}
+	return p.bs[int(p.bsp)+offset]
+}
+func (p *Parser) logicalAhead(count int) byte {
+	for offset := 0; ; offset++ {
+		b := p.physicalAhead(offset)
+		if b == '\\' && p.physicalAhead(offset+1) == '\n' {
+			offset++
+			continue
+		}
+		if count == 0 || b == utf8.RuneSelf {
+			return b
+		}
+		count--
+	}
+}
+func (p *Parser) logicalPeek() byte            { return p.logicalAhead(0) }
+func (p *Parser) logicalPeekTwo() (byte, byte) { return p.logicalAhead(0), p.logicalAhead(1) }
