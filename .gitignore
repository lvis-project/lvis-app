# Retired demo credentials must remain ignored: existing developer machines may
# still have these files, even though the application no longer reads them.
# Delete local copies and rotate any contained credentials out of band.
.env.demo
.env.demo.local

# Legacy bun binary lockfile — repo uses text bun.lock
bun.lockb

# Generated by `bun run build:icons` every build. The PNG assets are ignored so
# build output does not dirty worktrees. `build/icon.svg` and the two installer
# `.ico` files stay tracked instead: the signing job packages the installer from
# a plain checkout without running repository scripts, so it reads those bytes
# from the tree. `scripts/check-generated-assets.mjs` keeps the tracked ones
# equal to the generator's output.
build/icon.png
build/icons/
build/tray-icon.png
build/tray-icon@2x.png
build/tray-iconTemplate.png
build/tray-iconTemplate@2x.png
# The generator's record of what it wrote, consumed by the guard above.
build/generated-assets.json
main.js

# Test-run residue: teardown races can leave these behind. Written by
# src/audit/__tests__/dlp-stats.test.ts and
# src/plugins/__tests__/artifact-store-test-helpers.ts, which create them under
# `process.cwd()` rather than the OS temp dir. Ignored so a leaked directory does not read as
# an untracked source change.
/.artifact-store-*/
/.lvis-audit-test-*/
/.lvis-dlp-stats-*/
smoke-live-model.status.txt
smoke-live-app.status.txt
